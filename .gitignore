# AI Tools
.serena/

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.txt
coverage.html
*.coverprofile

# Go workspace file
go.work

# Build artifacts
/bin/
/build/
/dist/
/tmp/
/gz-pm
/gz-pm-*
/pmctl
/pmctl-*

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Dependency directories
vendor/

# Environment and configuration
.env
.env.local
*.local

# Logs
*.log
logs/

# Test caches and temporary files
.cache/
*.tmp

# CI/CD artifacts
.artifacts/

# Documentation build artifacts
docs/_build/

# OS-specific files
Thumbs.db
.DS_Store
.AppleDouble
.LSOverride

# Application specific
.pmctl/
!.pmctl/.gitkeep
.gz-pm/
!.gz-pm/.gitkeep

# `.ce/`는 CE 런타임 상태이므로 무시한다. 다만 루트의 task-runtime 선언은
# `ce task run-*`가 읽는 저장소 계약이므로 추적한다. 디렉터리를 먼저
# 되살리고 나머지 내용을 다시 제외한 다음 선언 파일만 예외로 둔다.
.ce/
!/.ce/
/.ce/*
!/.ce/task-runtime.yaml
